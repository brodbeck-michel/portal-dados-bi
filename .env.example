# ── Portal de Dados BI ────────────────────────────────────────────────────
# Copie para .env e ajuste. Nunca versionar o .env.

# Domínio da área do operador. Cada cliente vira um subdomínio dele:
#   local: BASE_DOMAIN=localhost         → http://acme.localhost:3000
#   VPS:   BASE_DOMAIN=bi.vitrocrm.cloud → https://acme.bi.vitrocrm.cloud
BASE_DOMAIN=localhost

# Porta publicada pelo docker compose. Na VPS: 127.0.0.1:8090 (só o Caddy acessa).
HTTP_PORT=127.0.0.1:3000

# true na VPS: o Caddy na frente informa o IP real (X-Forwarded-For) e o https.
TRUST_PROXY=false

# Cookie só por HTTPS. Padrão: true quando NODE_ENV=production (a imagem Docker).
# Rodando a imagem localmente por http://, use false — senão o login não "pega".
COOKIE_SECURE=false

# Sessão expira após X horas sem uso, ou X dias depois do login (o que vier antes).
SESSION_IDLE_HOURS=12
SESSION_MAX_DAYS=7

# Versão da imagem (tag do docker compose). Atualize a cada release.
APP_VERSION=0.2.0
